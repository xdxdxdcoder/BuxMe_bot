{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{tests/**,tmp/**,dist/**,node_modules/**,backend/parser.py}",
      "maxDuration": 300
    }
  }
}
